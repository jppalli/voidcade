{
  "name": "arcade-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-game arcade site. Each game lives in games/<name> as its own independent app; this root ties them together with a landing page and shared build/dev scripts.",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces --if-present && vite build && node scripts/copy-static-games.js",
    "preview": "vite preview",
    "dev:stackward": "npm run dev --workspace=stackward",
    "dev:pipsandpaths": "npm run dev --workspace=pipsandpaths",
    "dev:chessdoku": "npm run dev --workspace=chessdoku",
    "dev:kittydoku": "npm run dev --workspace=kittydoku",
    "dev:colorclues": "npm run dev --workspace=colorclues",
    "dev:riftpop": "npx --yes http-server games/riftpop -p 5187 -c-1",
    "dev:wordbloom": "npx --yes http-server games/wordbloom -p 5188 -c-1",
    "dev:panes": "npx --yes http-server games/panes -p 5175 -c-1"
  },
  "dependencies": {
    "@arcade/ads": "*"
  },
  "devDependencies": {
    "vite": "^8.1.4"
  }
}
